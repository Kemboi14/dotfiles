{
    "claudeCode.hideOnboarding": true,
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "github-authentication.preferDeviceCodeFlow": true,
    "workbench.colorTheme": "Wal Bordered",
    "workbench.iconTheme": "symbols",
    "workbench.productIconTheme": "fluent-icons",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": "'calt', 'zero'",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 14,
    "debug.console.fontFamily": "'JetBrainsMono Nerd Font'",
    "markdown.preview.fontFamily": "'JetBrainsMono Nerd Font', sans-serif",
    "scm.inputFontFamily": "'JetBrainsMono Nerd Font'",
    "window.zoomLevel": 0,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.minimap.enabled": false,
    "editor.renderLineHighlight": "gutter",
    "editor.padding.top": 12,
    "breadcrumbs.enabled": false,
    "window.titleBarStyle": "native",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "workbench.activityBar.location": "top",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "editor.lineNumbers": "relative",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.renderWhitespace": "boundary",
    "editor.stickyScroll.enabled": true,
    "terminal.integrated.cursorStyle": "line",
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "terminal.integrated.gpuAcceleration": "on",
    "walTheme.autoUpdate": true,
    "workbench.editor.showTabs": "single",
    "workbench.sideBar.location": "left",
    "workbench.editor.labelFormat": "short",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.scrollbar.verticalScrollbarSize": 6,
    "editor.scrollbar.horizontal": "hidden",
    "editor.hover.delay": 600,
    "explorer.compactFolders": false,
    "terminal.integrated.defaultProfile.linux": "fish",
    "workbench.secondarySideBar.defaultVisibility": "visible"
}
