{
  "theme": {
    "postHook": "/home/nick/.local/bin/raw-theme",
    "enableDiscord": false,
    "enableBtop": true,
    "enableHtop": false,
    "enableNvtop": false,
    "enableFuzzel": false,
    "iconThemeDark": "Colloid-Grey",
    "iconThemeLight": "Colloid-Grey"
  },
  "wallpaper": {
    "postHook": "[ \"$SCHEME_MODE\" = dark ] || caelestia scheme set -m dark -v \"$SCHEME_VARIANT\""
  }
}
