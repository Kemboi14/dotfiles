; Dynamic island, phase 1: clock when idle, music when playing.
(defpoll island_time :interval "5s" "date +%H:%M")
(defpoll island_date :interval "60s" "date '+%a %d'")
(deflisten music :initial "{\"status\":\"Stopped\",\"title\":\"\",\"artist\":\"\",\"art\":\"\"}"
  "~/.config/eww/scripts/island.sh music")
(defvar island_hover false)

(defwidget island []
  (eventbox :onhover "${EWW_CMD} update island_hover=true"
            :onhoverlost "${EWW_CMD} update island_hover=false"
    (box :class "island ${island_hover ? 'expanded' : ''} ${music.status == 'Playing' ? 'playing' : ''}"
         :orientation "h" :space-evenly false :spacing 10
      (box :visible {music.status != "Playing" && music.status != "Paused"}
           :class "idle" :space-evenly false :spacing 8
        (label :class "time" :text island_time)
        (label :class "date" :text island_date))
      (box :visible {music.status == "Playing" || music.status == "Paused"}
           :class "media" :space-evenly false :spacing 10
        (box :class "art" :visible {music.art != ""} :style "background-image: url('${music.art}');")
        (label :class "title" :limit-width {island_hover ? 40 : 22} :text {music.title})
        (revealer :reveal island_hover :transition "slideleft" :duration "250ms"
          (box :space-evenly false :spacing 12
            (label :class "artist" :limit-width 26 :text {music.artist})
            (button :class "ctl" :onclick "playerctl previous" "󰒮")
            (button :class "ctl play" :onclick "playerctl play-pause" {music.status == "Playing" ? "󰏤" : "󰐊"})
            (button :class "ctl" :onclick "playerctl next" "󰒭")))))))

(defwindow island
  :monitor 0
  :stacking "overlay"
  :exclusive false
  :namespace "eww-island"
  :geometry (geometry :anchor "top center" :y "8px" :height "36px")
  (island))
