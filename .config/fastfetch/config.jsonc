{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#b5c8df",
      "2": "#d9bed9"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ❯  ",
    "size": {
      "binaryPrefix": "si"
    },
    "color": {
      "keys": "#b5c8df",
      "separator": "#c1c7d1",
      "title": "#d9bed9"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;181;200;223m╭─── ✨ system ──────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "👤 Host      ",
      "text": "echo \"$USER@$(cat /etc/hostname)\""
    },
    {
      "type": "host",
      "key": "💻 Machine   "
    },
    {
      "type": "kernel",
      "key": "🐧 Kernel    "
    },
    {
      "type": "os",
      "key": "🏹 Distro    "
    },
    {
      "type": "wm",
      "key": "🪟 WM        "
    },
    {
      "type": "packages",
      "key": "📦 Packages  "
    },
    {
      "type": "shell",
      "key": "🐚 Shell     "
    },
    {
      "type": "terminal",
      "key": "🐱 Terminal  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;193;199;209m├─── 🔩 hardware ────────────────────────\u001b[0m"
    },
    {
      "type": "brightness",
      "key": "🔆 Brightness"
    },
    {
      "type": "display",
      "key": "📺 Resolution",
      "format": "{width}x{height}"
    },
    {
      "type": "uptime",
      "key": "⏳ Uptime    "
    },
    {
      "type": "cpu",
      "key": "🧠 CPU       "
    },
    {
      "type": "cpuusage",
      "key": "📈 CPU Load  "
    },
    {
      "type": "memory",
      "key": "🐏 Memory    ",
      "format": "{used} / {total}"
    },
    {
      "type": "battery",
      "key": "🔋 Battery   ",
      "format": "{capacity} & {status}"
    },
    {
      "type": "gpu",
      "key": "🎮 GPU       "
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;217;190;217m╰───────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
