{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Your Logo here",
    "type": "kitty",
    "height": 21,
    "width": 30,
    "padding": {
      "top": 3
    },
    "color": {
      "1": "#63cede",
      "2": "#63c9d1"
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#a0cede",
      "title": "#b8c9d1"
    },
    "percent": {
      "color": {
        "green": "#dabce4",
        "yellow": "#a0cede",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS   "
    },
    {
      "type": "kernel",
      "key": " ├  "
    },
    {
      "type": "packages",
      "format": "{} (pacman)",
      "key": " ├ 󰏖 "
    },
    {
      "type": "shell",
      "key": " └  "
    },
    "break",
    {
      "type": "wm",
      "key": "WM   "
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼 "
    },
    {
      "type": "icons",
      "key": " ├ 󰀻 "
    },
    {
      "type": "cursor",
      "key": " ├  "
    },
    {
      "type": "terminal",
      "key": " ├  "
    },
    {
      "type": "terminalfont",
      "key": " └  "
    },
    "break",
    {
      "type": "host",
      "format": "{name}",
      "key": "PC   "
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}",
      "key": " ├  "
    },
    {
      "type": "gpu",
      "format": "{1} {2} @ {12}",
      "key": " ├ 󰢮 "
    },
    {
      "type": "memory",
      "key": " ├  "
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 "
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 "
    },
    {
      "type": "display",
      "format": "{width}x{height} @ {refresh-rate} Hz",
      "key": " ├  "
    },
    {
      "type": "command",
      "key": " └ 󰍹 ",
      "format": "{} %",
      "text": "hyprctl monitors -j | jq -r '.[0].scale * 100 | floor'"
    },
    "break",
    "break"
  ]
}
