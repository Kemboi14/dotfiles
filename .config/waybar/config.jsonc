{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "group/apps",
        "group/ws"
    ],
    "modules-center": [
        "group/time",
        "group/player"
    ],
    "modules-right": [
        "tray",
        "group/stats",
        "group/system",
        "group/alerts"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "hyprland/window": {
        "format": " ",
        "icon": true,
        "icon-size": 20,
        "separate-outputs": true
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%a %d %b}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<span weight='bold'><u>{}</u></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "mpris": {
        "format": "{title}  {position}/{length}",
        "format-paused": "{title}  {position}/{length}",
        "title-len": 22,
        "interval": 1,
        "tooltip-format": "{artist} — {title}",
        "on-click": "playerctl play-pause"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 mute",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "backlight": {
        "format": "󰃠 {percent}%"
    },
    "network": {
        "interval": 5,
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf6ff wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {frequency} GHz\n{ifname}  {ipaddr}/{cidr}\n⇣ {bandwidthDownBits}   ⇡ {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}\n⇣ {bandwidthDownBits}   ⇡ {bandwidthUpBits}",
        "tooltip-format-disconnected": "No connection",
        "on-click": "~/.local/bin/wifimenu"
    },
    "battery": {
        "interval": 10,
        "states": { "warning": 20, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-discharging": "{icon} {capacity}% 󱐋{power:0.1f}W",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "format-time": "{H}h {M}m",
        "tooltip-format": "{timeTo}\nDraw: {power:0.1f} W"
    },
    "tray": {
        "spacing": 8
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.local/bin/powermenu"
    },
    "cpu": {
        "interval": 3,
        "format": "󰍛 {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7} {usage}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty --class btop -e btop"
    },
    "memory": {
        "interval": 10,
        "format": "󰘚 {icon} {used:0.1f}G",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "RAM  {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },
    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°",
        "format-critical": "󰸁 {temperatureC}°",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "CPU package: {temperatureC}°C"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Normal sleep"
    },
    "custom/weather": {
        "exec": "curl -sf \"wttr.in/?format=%c%t\"",
        "interval": 1800,
        "format": "{}",
        "tooltip": false
    },
    "custom/ws1": {
        "exec": "~/.local/bin/ws-status 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws2": {
        "exec": "~/.local/bin/ws-status 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws3": {
        "exec": "~/.local/bin/ws-status 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws4": {
        "exec": "~/.local/bin/ws-status 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/ws5": {
        "exec": "~/.local/bin/ws-status 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "custom/arch": {
        "format": "\uf303",
        "tooltip": false,
        "on-click": "fuzzel",
        "on-click-right": "~/.local/bin/powermenu"
    },
    "group/player": {
        "orientation": "horizontal",
        "modules": [
            "image#player-art",
            "mpris",
            "custom/cava",
            "custom/player-prev",
            "custom/player-play",
            "custom/player-next"
        ]
    },
    "image#player-art": {
        "exec": "/home/nick/.local/bin/waybar-player art",
        "size": 22,
        "interval": 2,
        "on-click": "playerctl play-pause"
    },
    "custom/cava": {
        "exec": "/home/nick/.local/bin/waybar-player cava",
        "format": "{}",
        "tooltip": false
    },
    "custom/player-prev": {
        "exec": "/home/nick/.local/bin/waybar-player icon prev",
        "format": "{}",
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    "custom/player-play": {
        "exec": "/home/nick/.local/bin/waybar-player icon play",
        "format": "{}",
        "tooltip": false,
        "on-click": "playerctl play-pause"
    },
    "custom/player-next": {
        "exec": "/home/nick/.local/bin/waybar-player icon next",
        "format": "{}",
        "tooltip": false,
        "on-click": "playerctl next"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "max-length": 24,
        "tooltip-format": "{controller_alias}  {controller_address}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "on-click": "kitty --class bluetui -e bluetui",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },
    "group/apps": {
        "orientation": "horizontal",
        "modules": ["custom/arch"]
    },
    "group/ws": {
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
    },
    "group/time": { "orientation": "horizontal", "modules": ["clock", "custom/weather"] },
    "group/stats": { "orientation": "horizontal", "modules": ["cpu", "temperature", "memory"] },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "pulseaudio", "backlight", "idle_inhibitor", "battery"]
    },
    "group/alerts": { "orientation": "horizontal", "modules": ["custom/notifications", "custom/power"] },
    "custom/notifications": {
        "exec": "~/.local/bin/notif-count",
        "return-type": "json",
        "interval": 3,
        "signal": 20,
        "on-click": "~/.local/bin/notif-count open",
        "on-click-right": "~/.local/bin/notif-count read"
    }
}
