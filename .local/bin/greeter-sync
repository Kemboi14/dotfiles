#!/usr/bin/env bash
# Sync wallpaper, Material You scheme and avatar into the greetd/ReGreet theme.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
scheme="$state/scheme.json"
wp_file="$state/wallpaper/path.txt"
face="$HOME/.face"
dest=/var/lib/greeter-theme
avatar_px=256          # source resolution of the circular crop
ring_px=8
avatar_show=128        # size drawn on the greeter, in screen pixels
avatar_top=210         # distance from the top of the screen to the avatar

# Greeter text (override any of these in ~/.config/greeter-sync.conf)
greet_title="${USER}@$(uname -n)"
greet_sub="~ \$ sudo make me a session"
show_sysinfo=1
bg_blur=7              # wallpaper defocus (0 = sharp)
bg_dim=28              # wallpaper darkening in percent
avatar_glow=1          # soft primary-coloured halo behind the avatar
title_pt=54
sub_pt=22
info_pt=18
# shellcheck source=/dev/null
[[ -r $HOME/.config/greeter-sync.conf ]] && source "$HOME/.config/greeter-sync.conf"

die() { echo "greeter-sync: $*" >&2; exit 1; }

command -v jq    >/dev/null || die "jq not installed"
command -v magick >/dev/null || die "imagemagick not installed"
[[ -r $scheme ]]  || die "scheme not readable: $scheme"
[[ -r $wp_file ]] || die "wallpaper state not readable: $wp_file"
wp=$(<"$wp_file")
[[ -r $wp ]]      || die "wallpaper not readable: $wp"
[[ -w $dest ]]    || die "destination not writable: $dest"

primary=$(jq -r '.colours.primary // empty' "$scheme")
primary="${primary#\#}"
[[ $primary =~ ^[0-9A-Fa-f]{6}$ ]] || die "invalid primary colour in scheme: $primary"

# Temp files live inside $dest so the final mv is an atomic rename on one filesystem.
tmp_wp=$(mktemp -p "$dest" .wallpaper.XXXXXX)
tmp_css=$(mktemp -p "$dest" .regreet.XXXXXX)
tmp_av=$(mktemp -p "$dest" .avatar.XXXXXX)
cleanup() { rm -f "$tmp_wp" "$tmp_css" "$tmp_av"; }
trap cleanup EXIT


have_avatar=0
if [[ -r $face ]]; then
  c=$((avatar_px / 2))
  r=$((c - ring_px / 2))
  magick "$face" \
    -resize "${avatar_px}x${avatar_px}^" -gravity center -extent "${avatar_px}x${avatar_px}" \
    \( -size "${avatar_px}x${avatar_px}" xc:black -fill white -draw "circle $c,$c $c,1" \) \
    -alpha off -compose CopyOpacity -composite \
    -compose over -fill none -stroke "#$primary" -strokewidth "$ring_px" \
    -draw "circle $c,$c $c,$((c - r))" \
    "PNG32:$tmp_av"
  have_avatar=1
fi

{
  while read -r key value; do
    value="${value#\#}"
    [[ $value =~ ^[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$ ]] || continue
    printf '@define-color %s #%s;\n' "$key" "$value"
  done < <(jq -r '.colours | to_entries[] | [.key, .value] | @tsv' "$scheme")
  cat <<'CSS'

* {
  font-family: "Space Grotesk", "Inter", "Noto Sans", sans-serif;
}

window {
  background-color: @surface;
  color: @onSurface;
}

frame {
  background-color: alpha(@surface, 0.62);
  border: 1px solid alpha(@primary, 0.22);
  border-radius: 28px;
  padding: 28px 32px;
  box-shadow: 0 20px 60px alpha(black, 0.55), inset 0 1px 0 alpha(white, 0.06);
}

label {
  color: @onSurface;
}

label.dim-label {
  color: @onSurfaceVariant;
}

entry {
  background: alpha(@surfaceContainer, 0.85);
  color: @onSurface;
  border: 1px solid alpha(@outline, 0.4);
  border-radius: 999px;
  min-height: 40px;
  padding: 0 16px;
  box-shadow: none;
  caret-color: @primary;
}

entry:focus-within {
  border-color: @primary;
  outline: none;
  box-shadow: 0 0 0 3px alpha(@primary, 0.25);
}

button {
  background: alpha(@surfaceContainer, 0.85);
  color: @onSurface;
  border: none;
  border-radius: 999px;
  padding: 8px 18px;
  box-shadow: none;
}

button:hover {
  background: alpha(@primary, 0.22);
}

button:active {
  background: alpha(@primary, 0.35);
}

button.suggested-action {
  background: @primary;
  color: @onPrimary;
  font-weight: bold;
  padding: 8px 26px;
  box-shadow: 0 6px 18px alpha(@primary, 0.35);
}

button.suggested-action:hover {
  background: mix(@primary, @onPrimary, 0.12);
}

button.destructive-action {
  background: @error;
  color: @onError;
}

popover contents {
  background: @surfaceContainer;
  color: @onSurface;
  border-radius: 16px;
  border: 1px solid alpha(@outline, 0.3);
}

popover modelbutton:hover {
  background: alpha(@primary, 0.2);
  border-radius: 10px;
}
CSS
} > "$tmp_css"
[[ -r $HOME/.config/greeter-sync.css ]] && cat "$HOME/.config/greeter-sync.css" >> "$tmp_css"

# Render the greeter wallpaper at the screen's size: one centred avatar plus nerdy text.
read -r scr_w scr_h < <(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused)][0] // .[0] | "\(.width) \(.height)"' 2>/dev/null || true)
[[ $scr_w =~ ^[0-9]+$ && $scr_h =~ ^[0-9]+$ ]] || { scr_w=1920; scr_h=1080; }

hexcol() { local v; v=$(jq -r --arg k "$1" '.colours[$k] // empty' "$scheme"); v="${v#\#}"; [[ $v =~ ^[0-9A-Fa-f]{6}$ ]] && echo "$v" || echo "$2"; }
fg=$(hexcol onSurface e3e2e6)
fg_dim=$(hexcol onSurfaceVariant c4c6d0)
shadow='#000000a0'

font_bold=$(fc-match -f '%{file}' 'Space Grotesk:style=Bold' 2>/dev/null || true)
font_reg=$(fc-match -f '%{file}' 'Space Grotesk:style=Regular' 2>/dev/null || true)

args=("$wp" -resize "${scr_w}x${scr_h}^" -gravity center -extent "${scr_w}x${scr_h}")
(( bg_blur > 0 )) && args+=( -blur "0x${bg_blur}" )
(( bg_dim > 0 ))  && args+=( -fill black -colorize "${bg_dim}%" )
if (( have_avatar )); then
  if (( avatar_glow )); then
    gpad=36
    gsz=$((avatar_show + 2 * gpad))
    gc=$((gsz / 2))
    args+=( \( -size "${gsz}x${gsz}" xc:none -fill "#${primary}" \
               -draw "circle $gc,$gc $gc,$((gpad - 4))" -channel A -evaluate multiply 0.9 +channel \
               -blur "0x18" \)
            -gravity north -geometry "+0+$((avatar_top - gpad))" -compose over -composite )
  fi
  args+=( \( "PNG:$tmp_av" -resize "${avatar_show}x${avatar_show}" \)
          -gravity north -geometry "+0+${avatar_top}" -compose over -composite )
fi
if [[ -r $font_bold && -r $font_reg ]]; then
  sub_y=$((60 + title_pt + 18))
  args+=( -gravity northwest
          -font "$font_bold" -pointsize "$title_pt"
          -fill "$shadow" -annotate +63+63 "$greet_title"
          -fill "#$primary" -annotate +60+60 "$greet_title"
          -font "$font_reg" -pointsize "$sub_pt"
          -fill "$shadow" -annotate +62+$((sub_y + 2)) "$greet_sub"
          -fill "#$fg_dim" -annotate +60+"$sub_y" "$greet_sub" )
  if (( show_sysinfo )); then
    kern=$(uname -r)
    hypr=$(Hyprland --version 2>/dev/null | awk 'NR==1 {print $2}')
    pkgs=$(pacman -Qq 2>/dev/null | wc -l)
    sysline="  Arch Linux      ${kern%%-*}      Hyprland ${hypr:-?}     󰏖  ${pkgs} pkgs"
    args+=( -gravity southwest -pointsize "$info_pt"
            -fill "$shadow" -annotate +62+46 "$sysline"
            -fill "#$fg" -annotate +60+48 "$sysline" )
  fi
fi
magick "${args[@]}" -quality 92 "JPEG:$tmp_wp"

chmod 644 "$tmp_wp" "$tmp_css" "$tmp_av"
mv -f "$tmp_wp" "$dest/wallpaper"
if (( have_avatar )); then
  mv -f "$tmp_av" "$dest/avatar.png"
else
  rm -f "$dest/avatar.png"
fi
mv -f "$tmp_css" "$dest/regreet.css"
echo "greeter-sync: synced $(basename "$wp"), scheme$( (( have_avatar )) && echo ", avatar")"
