#!/usr/bin/env bash
# Searchable cheat sheet of Hyprland keybinds (from their descriptions), shown in fuzzel.
set -euo pipefail

hyprctl binds -j | jq -r '
  def mods($m):
    [ (if ($m / 64 | floor) % 2 == 1 then "SUPER" else empty end),
      (if ($m / 4  | floor) % 2 == 1 then "CTRL"  else empty end),
      (if ($m / 8  | floor) % 2 == 1 then "ALT"   else empty end),
      (if  $m % 2 == 1               then "SHIFT" else empty end) ];
  .[]
  | select((.description // "") != "")
  | ((mods(.modmask) + [ (.key | ascii_upcase) ]) | join(" + ")) as $combo
  | "\($combo)\t\(.description)"
' | sort -u | awk -F'\t' '{ printf "%-26s %s\n", $1, $2 }' \
  | fuzzel --dmenu --prompt "󰌌  " --placeholder "search keybinds…" --width 60 >/dev/null || true
