#!/usr/bin/env bash
# Unread notification counter for Waybar (mako), event-driven:
#   notif-count [status]  Waybar JSON
#   notif-count bump      called by mako's on-notify: count it, chime unless DND, refresh bar
#   notif-count open      restore popups and mark all read
#   notif-count read      mark all read
#   notif-count dnd       toggle do-not-disturb
set -u
file="${XDG_RUNTIME_DIR:-/tmp}/waybar-notif-unread"
refresh() { pkill -RTMIN+20 -x waybar; }
dnd_on() { makoctl mode 2>/dev/null | grep -qx do-not-disturb; }

case "${1:-status}" in
  bump)
    n=0; [[ -r $file ]] && read -r n < "$file"
    echo $(( ${n:-0} + 1 )) > "$file"
    dnd_on || pw-play /usr/share/sounds/freedesktop/stereo/message.oga &
    refresh; wait; exit 0 ;;
  open) makoctl restore; echo 0 > "$file"; refresh; exit 0 ;;
  read) echo 0 > "$file"; refresh; exit 0 ;;
  dnd)  makoctl mode -t do-not-disturb >/dev/null; refresh; exit 0 ;;
esac

n=0; [[ -r $file ]] && read -r n < "$file"
n=${n:-0}
if dnd_on; then
  if (( n > 0 )); then text="󰂛 $n"; else text="󰂛"; fi
  printf '{"text":"%s","class":"dnd","tooltip":"Do not disturb · %d unread\\nclick open · right mark read · middle DND off"}\n' "$text" "$n"
elif (( n > 0 )); then
  printf '{"text":"󰂚 %d","class":"unread","tooltip":"%d unread · click open · right mark read · middle DND"}\n' "$n" "$n"
else
  printf '{"text":"󰂜","class":"empty","tooltip":"No new notifications · middle-click DND"}\n'
fi
