#!/usr/bin/env bash
# Pomodoro timer for Waybar: status | toggle | reset | skip
set -u
state_file="${XDG_RUNTIME_DIR:-/tmp}/waybar-pomodoro"
work=$((25 * 60))
rest=$((5 * 60))
ring=(󰪞 󰪟 󰪠 󰪡 󰪢 󰪣 󰪤 󰪥)

phase=work; status=idle; left=$work; end=0
[[ -r $state_file ]] && read -r phase status left end < "$state_file"
save() { echo "$phase $status $left $end" > "$state_file"; }
total() { [[ $phase == work ]] && echo "$work" || echo "$rest"; }
refresh() { pkill -RTMIN+19 -x waybar; }

case "${1:-status}" in
  toggle)
    if [[ $status == running ]]; then
      left=$(( end - $(date +%s) )); (( left < 0 )) && left=0; status=paused
    else
      end=$(( $(date +%s) + left )); status=running
    fi
    save; refresh; exit 0 ;;
  reset)
    phase=work; status=idle; left=$work; end=0; save; refresh; exit 0 ;;
  skip)
    if [[ $phase == work ]]; then phase=rest; else phase=work; fi
    status=idle; left=$(total); end=0; save; refresh; exit 0 ;;
esac

if [[ $status == running ]]; then
  left=$(( end - $(date +%s) ))
  if (( left <= 0 )); then
    if [[ $phase == work ]]; then
      notify-send -a Pomodoro "Focus session done" "Take a 5 minute break"; phase=rest
    else
      notify-send -a Pomodoro "Break over" "Back to focus"; phase=work
    fi
    status=idle; left=$(total); end=0; save
  fi
fi

t=$(total)
slice=$(( (t - left) * 8 / t )); (( slice > 7 )) && slice=7
icon="${ring[$slice]}"
[[ $status == idle ]] && icon="󰄰"
[[ $status == paused ]] && icon="󰏤"
label=$([[ $phase == work ]] && echo Focus || echo Break)
printf "{\"text\":\"%s %02d:%02d\",\"class\":\"%s %s\",\"tooltip\":\"%s · %s · click start/pause · right reset · middle skip\"}\n" \
  "$icon" $(( left / 60 )) $(( left % 60 )) "$status" "$phase" "$label" "$status"
