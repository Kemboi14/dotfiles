#!/usr/bin/env bash
choice=$(printf "󰌾  Lock\n󰤄  Suspend\n󰜉  Reboot\n󰐥  Shutdown\n󰍃  Log out\n" | fuzzel --dmenu --prompt "⏻  " --lines 5)
case "$choice" in
    *Lock)      hyprlock ;;
    *Suspend)   systemctl suspend ;;
    *Reboot)    systemctl reboot ;;
    *Shutdown)  systemctl poweroff ;;
    *"Log out") hyprctl dispatch "hl.dsp.exit()" ;;
esac
