# fastfetch: wallpaper-following colors
def _ff_ansi(hexcol):
    hc = hexcol.lstrip('#')
    r, g, b = int(hc[0:2],16), int(hc[2:4],16), int(hc[4:6],16)
    return f"\033[38;2;{r};{g};{b}m"
_ff_rst = "\033[0m"
_ff = home / ".config/fastfetch"
_ff.mkdir(parents=True, exist_ok=True)
_ff_cfg = {
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {"1": h("primary"), "2": h("tertiary")},
    "padding": {"top": 1, "left": 2, "right": 4}
  },
  "display": {
    "separator": "  ❯  ",
    "size": {"binaryPrefix": "si"},
    "color": {"keys": h("primary"), "separator": h("secondary"), "title": h("tertiary")}
  },
  "modules": [
    {"type":"custom","format": f"{_ff_ansi(h('primary'))}╭─── ✨ system ──────────────────────────{_ff_rst}"},
    {"type":"command","key":"👤 Host      ","text":"echo \"$USER@$(cat /etc/hostname)\""},
    {"type":"host","key":"💻 Machine   "},
    {"type":"kernel","key":"🐧 Kernel    "},
    {"type":"os","key":"🏹 Distro    "},
    {"type":"wm","key":"🪟 WM        "},
    {"type":"packages","key":"📦 Packages  "},
    {"type":"shell","key":"🐚 Shell     "},
    {"type":"terminal","key":"🐱 Terminal  "},
    {"type":"custom","format": f"{_ff_ansi(h('secondary'))}├─── 🔩 hardware ────────────────────────{_ff_rst}"},
    {"type":"brightness","key":"🔆 Brightness"},
    {"type":"display","key":"📺 Resolution","format":"{width}x{height}"},
    {"type":"uptime","key":"⏳ Uptime    "},
    {"type":"cpu","key":"🧠 CPU       "},
    {"type":"cpuusage","key":"📈 CPU Load  "},
    {"type":"memory","key":"🐏 Memory    ","format":"{used} / {total}"},
    {"type":"battery","key":"🔋 Battery   ","format":"{capacity} & {status}"},
    {"type":"gpu","key":"🎮 GPU       "},
    {"type":"custom","format": f"{_ff_ansi(h('tertiary'))}╰───────────────────────────────────────{_ff_rst}"},
    "break",
    {"type":"colors","symbol":"circle","paddingLeft":2}
  ]
}
(_ff / "config.jsonc").write_text(json.dumps(_ff_cfg, indent=2, ensure_ascii=False) + "\n")

# starship: wallpaper palette
_starship = home / ".config/starship.toml"
if _starship.exists():
    import re as _re2
    _st = _starship.read_text()
    _pal = f"""[palettes.wallpaper]
primary = "{h('primary')}"
secondary = "{h('secondary')}"
tertiary = "{h('tertiary')}"
success = "{h('success')}"
error = "{h('error')}"
surface = "{h('surface')}"
on_surface = "{h('onSurface')}"
muted = "{h('onSurfaceVariant')}"
"""
    if '[palettes.wallpaper]' in _st:
        _st = _re2.sub(r"\[palettes\.wallpaper\][\s\S]*?(?=\n\[|\Z)", _pal, _st)
    else:
        _st = _st.replace('palette = "wallpaper"', 'palette = "wallpaper"\n\n' + _pal, 1) if 'palette = "wallpaper"' in _st else 'palette = "wallpaper"\n\n' + _pal + "\n" + _st
    _starship.write_text(_st)

