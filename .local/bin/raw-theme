#!/usr/bin/env python3
"""Theme raw Hyprland tools from the Caelestia scheme, and set the wallpaper."""
import json, os, signal, subprocess, time
from pathlib import Path

home = Path.home()
state = home / ".local/state/caelestia"
raw = os.environ.get("SCHEME_COLOURS")
c = json.loads(raw) if raw else json.load(open(state / "scheme.json"))["colours"]
def h(k): return "#" + c[k]
keys = [
    "primary", "onPrimary", "primaryContainer",
    "secondary", "onSecondary", "secondaryContainer",
    "tertiary", "onTertiary", "tertiaryContainer",
    "error", "onError", "success", "onSuccess",
    "surface", "surfaceBright", "surfaceVariant",
    "surfaceContainerLowest", "surfaceContainerLow",
    "surfaceContainer", "surfaceContainerHigh", "surfaceContainerHighest",
    "onSurface", "onSurfaceVariant", "outline", "outlineVariant",
]

# Waybar colors
w = home / ".config/waybar"; w.mkdir(parents=True, exist_ok=True)
(w / "colors.css").write_text("".join(f"@define-color {k} {h(k)};\n" for k in keys))

# mako (notifications)
m = home / ".config/mako"; m.mkdir(parents=True, exist_ok=True)
(m / "config").write_text(f"""font=JetBrainsMono Nerd Font Propo 11
background-color={h("surfaceContainer")}c0
text-color={h("onSurface")}
border-color={h("primary")}
progress-color=over {h("primary")}
border-size=2
border-radius=14
padding=14
margin=14
width=380
max-icon-size=48
default-timeout=6000
max-history=50
include=/home/nick/.config/mako/extras

[urgency=critical]
border-color={h("error")}
default-timeout=0
""")

# hyprlock colors
(home / ".config/hypr/hyprlock-colors.conf").write_text(
    "".join(f"${k} = rgb({c[k]})\n" for k in keys))

# Reload running tools
subprocess.run(["makoctl", "reload"], capture_output=True)
subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], capture_output=True)

# Wallpaper: animated transition via awww (or swww); falls back to swaybg if neither is installed.
# The old wallpaper is only retired once the new one is confirmed up.
import shutil as _shutil
wp = (state / "wallpaper/path.txt").read_text().strip()
if os.environ.get("WAYLAND_DISPLAY") and Path(wp).is_file():
    ww = next((t for t in ("awww", "swww") if _shutil.which(t)), None)
    if ww:
        if subprocess.run([ww, "query"], capture_output=True).returncode != 0:
            subprocess.Popen([f"{ww}-daemon"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(30):
                time.sleep(0.1)
                if subprocess.run([ww, "query"], capture_output=True).returncode == 0:
                    break
        r = subprocess.run([ww, "img", wp,
                            "--transition-type", "left",
                            "--transition-duration", "1.2",
                            "--transition-fps", "60",
                            "--transition-bezier", ".43,1.19,1,.4"],
                           capture_output=True)
        if r.returncode == 0:
            subprocess.run(["pkill", "-x", "swaybg"], capture_output=True)
    else:
        old = subprocess.run(["pgrep", "-x", "swaybg"], capture_output=True, text=True).stdout.split()
        new = subprocess.Popen(["swaybg", "-m", "fill", "-i", wp], start_new_session=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.5)
        if new.poll() is None:
            for pid in old:
                try:
                    os.kill(int(pid), signal.SIGTERM)
                except ProcessLookupError:
                    pass

# pywal colors.json for VSCodium (Wal theme) and Pywalfox
wal = home / ".cache/wal"; wal.mkdir(parents=True, exist_ok=True)
pal = {f"color{i}": "#" + c.get(f"term{i}", "808080") for i in range(16)}
pal["color0"] = h("surface"); pal["color15"] = h("onSurface")
wp_file = state / "wallpaper/path.txt"
json.dump({"wallpaper": wp_file.read_text().strip() if wp_file.exists() else "", "alpha": "100",
           "special": {"background": h("surface"), "foreground": h("onSurface"), "cursor": h("primary")},
           "colors": pal}, open(wal / "colors.json", "w"), indent=2)

# Restart swayosd so the pop-up uses the new colors
_osd = subprocess.run(["pkill", "-x", "swayosd-server"], capture_output=True).returncode == 0
_osd and subprocess.Popen(["swayosd-server"], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# fuzzel (launcher and menus): frosted glass
f = home / ".config/fuzzel"; f.mkdir(parents=True, exist_ok=True)
(f / "fuzzel.ini").write_text(f"""[main]
font=JetBrainsMono Nerd Font Propo:size=10,Symbols Nerd Font:size=10
icon-theme=Colloid-Dark
terminal=kitty
layer=overlay
width=34
lines=8
horizontal-pad=14
vertical-pad=10
inner-pad=10
line-height=20

[colors]
background={c["surface"]}b3
text={c["onSurface"]}ff
prompt={c["primary"]}ff
placeholder={c["onSurfaceVariant"]}aa
input={c["onSurface"]}ff
match={c["tertiary"]}ff
selection={c["primary"]}55
selection-text={c["onSurface"]}ff
selection-match={c["tertiary"]}ff
border={c["primary"]}ff

[border]
width=2
radius=18
""")

# Plain pywal colour list for tools that read ~/.cache/wal/colors (VSCodium Wal Theme)
(wal / "colors").write_text("".join(pal[f"color{i}"] + "\n" for i in range(16)))

# eww dashboard colours
e = home / ".config/eww"; e.mkdir(parents=True, exist_ok=True)
(e / "colors.scss").write_text("".join(f"${k}: {h(k)};\n" for k in keys))
try:
    subprocess.run(["eww", "reload"], capture_output=True)
except FileNotFoundError:
    pass




# SDDM login screen follows the scheme and wallpaper
import re as _re
_sd = Path("/usr/share/sddm/themes/sddm-astronaut-theme")
_conf = _sd / "Themes/nick.conf"
_bg = _sd / "Backgrounds/current.jpg"
if _conf.exists() and os.access(_conf, os.W_OK) and os.access(_bg, os.W_OK):
    try:
        _wp = (state / "wallpaper/path.txt").read_text().strip()
        subprocess.run(["magick", _wp, "-resize", "1920x1080^", "-gravity", "center", "-extent", "1920x1080", "-quality", "90", "jpg:" + str(_bg)], capture_output=True, timeout=30)
        H = lambda k: "\"#" + c[k] + "\""
        _map = {
            "Background": "\"Backgrounds/current.jpg\"",
            "DimBackground": "\"0.25\"",
            "HeaderTextColor": H("onSurface"), "TimeTextColor": H("onSurface"), "DateTextColor": H("onSurfaceVariant"),
            "FormBackgroundColor": H("surface"), "BackgroundColor": H("surface"), "DimBackgroundColor": H("surface"),
            "LoginFieldBackgroundColor": H("surfaceContainer"), "PasswordFieldBackgroundColor": H("surfaceContainer"),
            "LoginFieldTextColor": H("onSurface"), "PasswordFieldTextColor": H("onSurface"),
            "UserIconColor": H("primary"), "PasswordIconColor": H("primary"),
            "PlaceholderTextColor": H("onSurfaceVariant"), "WarningColor": H("error"),
            "LoginButtonTextColor": H("onPrimary"), "LoginButtonBackgroundColor": H("primary"),
            "SystemButtonsIconsColor": H("onSurfaceVariant"), "SessionButtonTextColor": H("onSurfaceVariant"),
            "VirtualKeyboardButtonTextColor": H("onSurfaceVariant"),
            "DropdownTextColor": H("onSurface"), "DropdownBackgroundColor": H("surfaceContainer"),
            "DropdownSelectedBackgroundColor": H("primaryContainer"),
            "HighlightTextColor": H("onPrimary"), "HighlightBackgroundColor": H("primary"), "HighlightBorderColor": H("primary"),
            "HoverUserIconColor": H("tertiary"), "HoverPasswordIconColor": H("tertiary"),
            "HoverSystemButtonsIconsColor": H("tertiary"), "HoverSessionButtonTextColor": H("tertiary"),
            "HoverVirtualKeyboardButtonTextColor": H("tertiary"),
        }
        _txt = _conf.read_text()
        for _k, _v in _map.items():
            _txt = _re.sub(r"^" + _k + r"=.*$", lambda _m, _k=_k, _v=_v: _k + "=" + _v, _txt, flags=_re.M)
        _conf.write_text(_txt)
    except Exception:
        pass



# Firefox colours via Pywalfox
try:
    subprocess.run(["pywalfox", "update"], capture_output=True, timeout=10)
except Exception:
    pass
# Kitty colors.conf and live reload
_kc = home / ".config/kitty/colors.conf"
_kc.parent.mkdir(parents=True, exist_ok=True)
_k_lines = [
    f"foreground {h('onSurface')}",
    f"background {h('surface')}",
    f"cursor {h('primary')}",
    f"cursor_text_color {h('onPrimary')}",
    f"selection_foreground {h('onPrimary')}",
    f"selection_background {h('primary')}",
    f"active_border_color {h('primary')}",
    f"inactive_border_color {h('outline')}",
    f"active_tab_foreground {h('onPrimary')}",
    f"active_tab_background {h('primary')}",
    f"inactive_tab_foreground {h('onSurfaceVariant')}",
    f"inactive_tab_background {h('surfaceContainer')}",
]
for _i in range(16):
    _k_lines.append(f"color{_i} {pal[f'color{_i}']}")
_kc.write_text(chr(10).join(_k_lines) + chr(10))
subprocess.run(["pkill", "-SIGUSR1", "-x", "kitty"], capture_output=True)

# GTK3 & GTK4 CSS variables for Thunar and GTK apps
_gtk_lines = [
    f"@define-color accent_color {h('primary')};",
    f"@define-color accent_fg_color {h('onPrimary')};",
    f"@define-color accent_bg_color {h('primary')};",
    f"@define-color window_bg_color {h('surface')};",
    f"@define-color window_fg_color {h('onSurface')};",
    f"@define-color headerbar_bg_color {h('surfaceContainer')};",
    f"@define-color headerbar_fg_color {h('onSurface')};",
    f"@define-color popover_bg_color {h('surfaceContainerHigh')};",
    f"@define-color popover_fg_color {h('onSurface')};",
    f"@define-color view_bg_color {h('surface')};",
    f"@define-color view_fg_color {h('onSurface')};",
    f"@define-color card_bg_color {h('surfaceContainer')};",
    f"@define-color card_fg_color {h('onSurface')};",
    "@define-color sidebar_bg_color @window_bg_color;",
    "@define-color sidebar_fg_color @window_fg_color;",
    "@define-color sidebar_border_color @window_bg_color;",
    "@define-color sidebar_backdrop_color @window_bg_color;",
    "@define-color theme_selected_bg_color alpha(@accent_color, 0.15);",
    f"@define-color theme_selected_fg_color {h('primary')};",
    f"@define-color thunar_bg {h('surfaceContainerLow')};",
    f"@define-color thunar_accent {h('primary')};",
    f"@define-color thunar_fg {h('onSurface')};",
    "",
    "@import " + chr(34) + "thunar.css" + chr(34) + ";",
]
_gtk_css = chr(10).join(_gtk_lines) + chr(10)
for _gdir in (home / ".config/gtk-3.0", home / ".config/gtk-4.0"):
    _gdir.mkdir(parents=True, exist_ok=True)
    (_gdir / "gtk.css").write_text(_gtk_css)
try:
    _cur_theme = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"], capture_output=True, text=True).stdout.strip().strip(chr(39) + chr(34))
    if _cur_theme:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", ""], capture_output=True)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", _cur_theme], capture_output=True)
except Exception:
    pass

