#!/usr/bin/env python3
"""Theme raw Hyprland tools from the Caelestia scheme, and set the wallpaper."""
import json, os, subprocess
from pathlib import Path

home = Path.home()
state = home / ".local/state/caelestia"
raw = os.environ.get("SCHEME_COLOURS")
c = json.loads(raw) if raw else json.load(open(state / "scheme.json"))["colours"]
def h(k): return "#" + c[k]
keys = ["primary", "onPrimary", "secondary", "tertiary", "surface", "surfaceContainer",
        "surfaceContainerHigh", "onSurface", "onSurfaceVariant", "outline", "error"]

# Waybar colors
w = home / ".config/waybar"; w.mkdir(parents=True, exist_ok=True)
(w / "colors.css").write_text("".join(f"@define-color {k} {h(k)};\n" for k in keys))

# mako (notifications)
m = home / ".config/mako"; m.mkdir(parents=True, exist_ok=True)
(m / "config").write_text(f"""font=Inter 11
background-color={h("surfaceContainer")}cc
text-color={h("onSurface")}
border-color={h("primary")}
progress-color=over {h("primary")}
border-size=2
border-radius=14
padding=14
margin=14
width=380
max-icon-size=48
default-timeout=6000

[urgency=critical]
border-color={h("error")}
default-timeout=0
""")

# hyprlock colors
(home / ".config/hypr/hyprlock-colors.conf").write_text(
    "".join(f"${k} = rgb({c[k]})\n" for k in keys))

# Reload running tools
subprocess.run(["makoctl", "reload"], capture_output=True)
subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], capture_output=True)

# Wallpaper (only if the Caelestia shell is not running)
if subprocess.run(["pgrep", "-f", "qs -c caelestia"], capture_output=True).returncode != 0:
    wp = (state / "wallpaper/path.txt").read_text().strip()
    subprocess.run(["pkill", "-x", "swaybg"], capture_output=True)
    subprocess.Popen(["swaybg", "-m", "fill", "-i", wp], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# pywal colors.json for VSCodium (Wal theme) and Pywalfox
wal = home / ".cache/wal"; wal.mkdir(parents=True, exist_ok=True)
pal = {f"color{i}": "#" + c.get(f"term{i}", "808080") for i in range(16)}
pal["color0"] = h("surface"); pal["color15"] = h("onSurface")
wp_file = state / "wallpaper/path.txt"
json.dump({"wallpaper": wp_file.read_text().strip() if wp_file.exists() else "", "alpha": "100",
           "special": {"background": h("surface"), "foreground": h("onSurface"), "cursor": h("primary")},
           "colors": pal}, open(wal / "colors.json", "w"), indent=2)

# Restart swayosd so the pop-up uses the new colors
subprocess.run(["pkill", "-x", "swayosd-server"], capture_output=True)
subprocess.Popen(["swayosd-server"], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# fuzzel (launcher and menus): frosted glass
f = home / ".config/fuzzel"; f.mkdir(parents=True, exist_ok=True)
(f / "fuzzel.ini").write_text(f"""[main]
font=Inter:size=12
icon-theme=Papirus-Dark
terminal=kitty
layer=overlay
width=42
lines=10
horizontal-pad=22
vertical-pad=16
inner-pad=10
line-height=26

[colors]
background={c["surface"]}b3
text={c["onSurface"]}ff
prompt={c["primary"]}ff
placeholder={c["onSurfaceVariant"]}aa
input={c["onSurface"]}ff
match={c["tertiary"]}ff
selection={c["primary"]}55
selection-text={c["onSurface"]}ff
selection-match={c["tertiary"]}ff
border={c["primary"]}ff

[border]
width=2
radius=18
""")
