#!/usr/bin/env bash
# Pick a video from ~/Videos or ~/Downloads with fuzzel; mpv queues the rest of its folder.
set -euo pipefail
pick=$(fd -t f -e mp4 -e mkv -e webm -e avi -e mov -e m4v . "$HOME/Videos" "$HOME/Downloads" 2>/dev/null \
  | sed "s|^$HOME/||" | sort | fuzzel --dmenu --prompt "Video: " --width 70) || exit 0
[[ -n $pick ]] || exit 0
exec mpv --player-operation-mode=pseudo-gui "$HOME/$pick"
