#!/usr/bin/env bash
# Skewed-carousel wallpaper picker (Quickshell). Runs again to close it.
set -euo pipefail

cfg="$HOME/.config/wallpicker"
if pgrep -f "quickshell -p $cfg" >/dev/null; then
  pkill -f "quickshell -p $cfg"
  exit 0
fi

"$HOME/.local/bin/wallpicker-index"

state="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
export WALLPICKER_INDEX="${XDG_CACHE_HOME:-$HOME/.cache}/wallpicker/index.json"
export WALLPICKER_SCHEME="$state/scheme.json"
WALLPICKER_CURRENT=$(realpath -e -- "$(cat "$state/wallpaper/path.txt" 2>/dev/null)" 2>/dev/null || true)
export WALLPICKER_CURRENT

exec quickshell -p "$cfg"
