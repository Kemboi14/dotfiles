#!/usr/bin/env bash
set -euo pipefail
dir="$HOME/Pictures/Wallpapers"
choice=$( {
  echo "🎲 Random"
  find -L "$dir" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -printf "%f\n" | sort
} | fuzzel --dmenu --prompt "󰸉  " --placeholder "search wallpapers…")
[ -z "$choice" ] && exit 0
if [ "$choice" = "🎲 Random" ]; then
  chosen=$(find -L "$dir" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | shuf -n1)
  "$HOME/.local/bin/scheme-gen" "$chosen"
else
  "$HOME/.local/bin/scheme-gen" "$dir/$choice"
fi
