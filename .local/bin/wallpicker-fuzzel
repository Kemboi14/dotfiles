#!/usr/bin/env bash
dir="$HOME/Pictures/Wallpapers"
choice=$( { echo "🎲 Random"; find -L "$dir" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -printf "%f\n" | sort; } \
    | fuzzel --dmenu --prompt "󰸉  " --placeholder "search wallpapers…")
[ -z "$choice" ] && exit 0
if [ "$choice" = "🎲 Random" ]; then
    caelestia wallpaper -r
else
    caelestia wallpaper -f "$dir/$choice"
fi
