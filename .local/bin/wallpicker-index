#!/usr/bin/env bash
# Build cached thumbnails and a colour index for wallpicker.
# Incremental: only new or changed images are processed; stale cache entries are pruned.
set -euo pipefail

dir="$HOME/Pictures/Wallpapers"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallpicker"
thumbs="$cache/thumbs"
mkdir -p "$thumbs"

command -v magick >/dev/null || { echo "wallpicker-index: imagemagick not installed" >&2; exit 1; }
command -v jq >/dev/null     || { echo "wallpicker-index: jq not installed" >&2; exit 1; }

# Map an average colour (hue 0-360, saturation 0-1, lightness 0-1) to a filter bucket.
bucket() {
  awk -v h="$1" -v s="$2" -v l="$3" 'BEGIN {
    if (s < 0.18 || l < 0.08 || l > 0.92) { print "gray"; exit }
    if (h < 15 || h >= 345)  print "red"
    else if (h < 45)         print "orange"
    else if (h < 70)         print "yellow"
    else if (h < 170)        print "green"
    else if (h < 255)        print "blue"
    else if (h < 315)        print "purple"
    else                     print "pink"
  }'
}

tsv=$(mktemp)
trap 'rm -f "$tsv"' EXIT
declare -A keep=()
new=0

while IFS= read -r -d '' f; do
  real=$(realpath -e -- "$f") || continue
  key=$(printf '%s:%s' "$real" "$(stat -Lc %Y -- "$f")" | sha1sum | cut -c1-16)
  thumb="$thumbs/$key.jpg"
  meta="$thumbs/$key.hue"
  if [[ ! -s $thumb || ! -s $meta ]]; then
    magick "${f}[0]" -auto-orient -thumbnail '640x400^' -gravity center -extent 640x400 -quality 82 "$thumb"
    hsl=$(magick "$thumb" -resize '1x1!' -format '%[fx:hue*360] %[fx:saturation] %[fx:lightness]' info:)
    read -r h s l <<< "$hsl"
    bucket "${h:-0}" "${s:-0}" "${l:-0.5}" > "$meta"
    new=$((new + 1))
    (( new % 25 == 0 )) && echo "wallpicker-index: $new new thumbnails…" >&2
  fi
  keep[$key]=1
  printf '%s\t%s\t%s\t%s\t%s\n' "$f" "$real" "$(basename -- "$f")" "$thumb" "$(<"$meta")" >> "$tsv"
done < <(find -L "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)

# Prune cache entries for images that were removed or changed.
for t in "$thumbs"/*.jpg; do
  [[ -e $t ]] || continue
  k=$(basename -- "$t" .jpg)
  [[ -n ${keep[$k]:-} ]] || rm -f -- "$t" "$thumbs/$k.hue"
done

jq -R -s 'split("\n") | map(select(length > 0) | split("\t")
  | {path: .[0], real: .[1], name: .[2], thumb: .[3], hue: .[4]})' "$tsv" > "$cache/index.json.tmp"
mv -f "$cache/index.json.tmp" "$cache/index.json"
(( new > 0 )) && echo "wallpicker-index: $new new, ${#keep[@]} total" >&2
exit 0
