#!/usr/bin/env bash
list=$(while IFS=: read -r inuse ssid signal sec; do
    [ -z "$ssid" ] && continue
    icon="󰖩"; [ "$inuse" = "*" ] && icon="󰄬"
    lock=""; [ -n "$sec" ] && [ "$sec" != "--" ] && lock="󰌾"
    echo "$icon $ssid  $signal%  $lock"
done < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan auto))
choice=$(printf "%s\n" "$list" | fuzzel --dmenu --prompt "󰖩  " --lines 10 --width 45)
[ -z "$choice" ] && exit 0
ssid=$(echo "$choice" | sed -E "s/^[^ ]+ //; s/  [0-9]+%.*$//")
if nmcli -t -f NAME con show | grep -Fxq "$ssid"; then
    nmcli con up id "$ssid" && notify-send "󰖩 Connected" "$ssid"
else
    pass=$(fuzzel --dmenu --password --prompt "password for $ssid: " --lines 0)
    nmcli dev wifi connect "$ssid" password "$pass" && notify-send "󰖩 Connected" "$ssid" || notify-send -u critical "Wi-Fi" "Could not connect to $ssid"
fi
