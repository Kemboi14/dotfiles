#!/usr/bin/env python3
"""Refresh Waybar workspace buttons whenever Hyprland changes workspace or windows."""
import os, socket, subprocess, time
sock = os.path.join(os.environ["XDG_RUNTIME_DIR"], "hypr", os.environ["HYPRLAND_INSTANCE_SIGNATURE"], ".socket2.sock")
events = ("workspace>>", "workspacev2>>", "openwindow>>", "closewindow>>", "movewindow>>", "focusedmon>>")
while True:
    try:
        s = socket.socket(socket.AF_UNIX); s.connect(sock)
        buf = b""
        while chunk := s.recv(4096):
            buf += chunk
            *lines, buf = buf.split(b"\n")
            if any(l.decode(errors="ignore").startswith(events) for l in lines):
                subprocess.run(["pkill", "-RTMIN+8", "-x", "waybar"])
    except OSError:
        time.sleep(2)
